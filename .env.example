# ── Storage ────────────────────────────────────────────────────────────────
GTL_DB_PATH=data/gtleague.db

# ── GT Leagues results API (no auth; needs browser-ish identity headers) ──
GTL_API_BASE=https://api.gtleagues.com/api
GTL_ORIGIN=https://www.gtleagues.com
GTL_REQUEST_DELAY_S=0.5

# ── betPawa odds feed ──────────────────────────────────────────────────────
BETPAWA_BASE=https://www.betpawa.ug
BETPAWA_BRAND=betpawa-uganda
BETPAWA_CATEGORY=101
BETPAWA_COMPETITION=17491
BETPAWA_MARKET_TYPES=3743,5000
# Captured from browser devtools (see scraper/betpawa.curl). Re-capture on 401/403.
BETPAWA_FINGERPRINT=change-me
# Not needed as of the 2026-07-08 probe (feed answered cookie-less), but supported:
BETPAWA_TOKEN=
BETPAWA_CF_BM=

# ── Predictor serving knobs (defaults shown; see libs/py/core/config.py) ──
# PICK_PROB_THRESHOLD=0.60   # model prob of a side needed to surface a pick
# MAX_PUSH_PROB=0.20
# MIN_EDGE=0.05              # model-book edge for the value flag
# TOTALS_SOURCE=blend        # blend | poisson
# TOTALS_BLEND_WEIGHT=0.7
# ── Tier bands; must partition [PICK_PROB_THRESHOLD, 1] ──
# TIER_LEAN=0.60             # keep == PICK_PROB_THRESHOLD or lean is unreachable
# TIER_SOLID=0.64
# TIER_STRONG=0.69            # re-quantiled 2026-07-12 (schedule population)
# ── Settlement ──
# SETTLE_DELAY_MIN=30        # minutes after kickoff before a fixture may
#                            # settle; measured floor ~25 (2026-07-15), late
#                            # results just stay pending and retry
# ── Per-line Platt recalibration (docs/RECAL_SERVING.md) ──
# RECAL_ENABLED=true         # false = full rollback to pre-recal pricing
# RECAL_DAYS=14              # settled-prediction window the maps are fit on
# RECAL_MIN_N=300            # graded samples a line needs for its own 2-param map
# RECAL_MIN_N_LINE=75        # thin-line tier: pooled slope + own intercept
#                            # (0 = disable the tier; pre-2026-07-11 behavior)
# ── Club as a second GLM entity (docs/CLUB_FEATURE.md) ──
# CLUB_ENABLED=false         # true = serve club-conditioned lambdas (opt-in)
# ── 1x2 serving head (docs/X12_SERVING.md) ──
# X12_ENABLED=false          # true = serve match-winner predictions (opt-in)
# X12_PICK_PROB_THRESHOLD=0.50  # measured; NOT the totals 0.60 (3-outcome scale)
# ── H2H stacker on the 1x2 head (docs/H2H_FEATURE.md) ──
# X12_H2H_ENABLED=false      # true = restack the decisive split with pair
#                            # history (needs X12_ENABLED; identity + no -h2h
#                            # tag until a population has X12_H2H_MIN_N rows)
# X12_H2H_DAYS=14            # settled predictions_x12 window the fit uses
# X12_H2H_MIN_N=500          # decisive graded rows a population needs to engage
# ── Pair-pace term in the totals recal maps (docs/TOTALS_H2H.md) ──
# TOTALS_H2H_ENABLED=false   # true = extend the per-line Platt maps with
#                            # c*pace_decay (needs RECAL_ENABLED; engagement
#                            # rides RECAL_DAYS/MIN_N/MIN_N_LINE — no knobs of
#                            # its own; extended rows carry -recal2-h2h)
# ── Cyclic time-of-day term in the GLM (docs/TOD_FEATURE.md) ──
# TOD_ENABLED=false          # true = serve hour-conditioned lambdas (opt-in)
